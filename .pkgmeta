package-as: Polymorph

enable-nolib-creation: no

externals:
    LibStub: svn://svn.wowace.com/wow/libstub/mainline/trunk

ignore:
    - tests
    - docs
    - AGENTS.md
    - CLAUDE.md
    - .luarc.json
    - tools
    - REVIEW.md
    - skills

manual-changelog:
    filename: CHANGELOG.md
    markup-type: markdown
